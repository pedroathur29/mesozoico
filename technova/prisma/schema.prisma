// Banco de dados da TECHNOVA (PostgreSQL).
// Valores monetários são guardados em centavos (Int) para evitar erros de arredondamento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  icon        String    @default("box")
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  sku              String?        @unique
  shortDescription String         @default("")
  description      String         @default("")
  howItWorks       String         @default("")
  /// Lista de características técnicas: [{ "label": "Resolução", "value": "2K" }]
  specs            Json           @default("[]")
  priceCents       Int
  salePriceCents   Int?
  stock            Int            @default(0)
  active           Boolean        @default(true)
  featured         Boolean        @default(false)
  /// Marca produtos de demonstração que precisam ser substituídos antes da abertura da loja.
  isDemo           Boolean        @default(false)
  salesCount       Int            @default(0)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  reviews          Review[]
  orderItems       OrderItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([active, featured])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Caminho público ou URL externa. Vazio quando a imagem foi enviada pelo painel (fica em `data`).
  url       String?
  data      Bytes?
  mimeType  String?
  alt       String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  /// Nenhum provedor de pagamento integrado ainda: o pedido aguarda contato da loja.
  AWAITING_INTEGRATION
  PENDING
  APPROVED
  REFUSED
  REFUNDED
}

model Order {
  id                String        @id @default(cuid())
  code              String        @unique
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus @default(AWAITING_INTEGRATION)
  paymentMethod     String
  paymentProvider   String?
  paymentReference  String?
  customerName      String
  customerEmail     String
  customerPhone     String
  customerDocument  String?
  zipCode           String
  street            String
  number            String
  complement        String?
  district          String
  city              String
  state             String
  notes             String?
  subtotalCents     Int
  discountCents     Int           @default(0)
  /// Nulo enquanto o frete não é calculado (sem integração de frete configurada).
  shippingCents     Int?
  totalCents        Int
  items             OrderItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  sku            String?
  imageUrl       String?
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId, approved])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}
