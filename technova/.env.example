# Copie para .env (desenvolvimento) ou cadastre na hospedagem (produção).
# NUNCA faça commit do arquivo .env com valores reais.

# Banco PostgreSQL. Em Neon/Supabase use a URL com pool em DATABASE_URL e a direta em DIRECT_URL.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/technova?schema=public"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/technova?schema=public"

# Segredo para assinar a sessão do painel. Gere com: openssl rand -base64 48
AUTH_SECRET=""

# Endereço público da loja (usado em SEO, sitemap e links). Sem barra no final.
NEXT_PUBLIC_SITE_URL="https://www.seudominio.com.br"

# WhatsApp oficial, só números com DDI e DDD. Ex.: 5511999999999. Vazio = botão oculto.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Contato e dados exibidos no rodapé e nas páginas institucionais (opcionais).
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_COMPANY_LEGAL_NAME=""
NEXT_PUBLIC_COMPANY_CNPJ=""
NEXT_PUBLIC_COMPANY_ADDRESS=""
NEXT_PUBLIC_BUSINESS_HOURS=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_TIKTOK_URL=""

# Ative somente quando a operação de entrega nacional estiver configurada.
NEXT_PUBLIC_SHIPS_NATIONWIDE="false"

# Parcelamento sem juros exibido nos preços (ex.: 10). Deixe 0 até o meio de pagamento oferecer.
NEXT_PUBLIC_MAX_INSTALLMENTS="0"

# Exige CPF no checkout (necessário para emissão de NF-e e para a maioria dos gateways).
NEXT_PUBLIC_REQUIRE_CPF="true"

# Mostra o aviso de "produtos demonstrativos" no topo do site enquanto houver itens de exemplo.
NEXT_PUBLIC_SHOW_DEMO_NOTICE="true"

# Primeiro administrador do painel (usado por `npm run db:seed` ou `npm run admin:create`).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
